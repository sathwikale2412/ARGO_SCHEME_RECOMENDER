# ARGO — configuration
# The same project URL/key is used twice: prefixed with VITE_ for the browser, and
# unprefixed for the Python API function. All four are public anon credentials guarded
# by Row Level Security — never put the service_role key here.

# Browser (Vite inlines these at build time)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY
# Only needed if the API is not served from /api on the same origin.
# VITE_API_BASE=https://your-app.vercel.app/api

# API function (read by api/supabase_client.py)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY
